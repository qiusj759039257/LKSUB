Dialogue: 1,0:23:44.99,0:23:49.95,Title,,0,0,0,,{\fad(477,0)\c&HFFA4F0&\pos(1822.488,917.499)}盛夏的纶纶度假村
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,======================================== PS ========================================
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,======================================== TEXT ========================================
Dialogue: 0,0:01:32.86,0:01:37.66,Default,,0,0,0,,锵 可爱的露肩上衣噗妮露哦
Dialogue: 0,0:01:37.97,0:01:41.23,DefaultTop,,0,0,0,,今天一定要让小太郎说我可爱
Dialogue: 0,0:01:42.11,0:01:42.55,Default,,0,0,0,,啊
Dialogue: 0,0:01:44.12,0:01:46.22,Default,,0,0,0,,又是那个盗版货！
Dialogue: 0,0:01:47.88,0:01:51.76,Default,,0,0,0,,小太郎大人害羞了吗 好可爱
Dialogue: 0,0:01:52.26,0:01:55.26,Default,,0,0,0,,够了够了 别再擦了
Dialogue: 0,0:01:55.62,0:01:57.33,Default,,0,0,0,,小太郎大人真是的
Dialogue: 0,0:01:57.33,0:02:02.27,Default,,0,0,0,,为了考验朱丽居然故意打翻果汁
Dialogue: 0,0:02:02.27,0:02:05.65,Default,,0,0,0,,不是 我只是手滑了而已
Dialogue: 0,0:02:05.65,0:02:10.28,Default,,0,0,0,,完美的小太郎大人怎么可能犯这种错误
Dialogue: 0,0:02:11.69,0:02:13.48,Default,,0,0,0,,真好啊 我也想这样
Dialogue: 0,0:02:13.48,0:02:15.28,Default,,0,0,0,,小太郎小太郎
Dialogue: 0,0:02:15.59,0:02:16.56,Default,,0,0,0,,我说
Dialogue: 0,0:02:17.33,0:02:18.32,Default,,0,0,0,,噗妮露
Dialogue: 0,0:02:18.32,0:02:20.06,Default,,0,0,0,,我这身怎么样
Dialogue: 0,0:02:21.12,0:02:22.37,Default,,0,0,0,,挺好的嘛
Dialogue: 0,0:02:24.33,0:02:27.35,Default,,0,0,0,,这样 怎么样
Dialogue: 0,0:02:27.84,0:02:29.04,Default,,0,0,0,,够了啦
Dialogue: 0,0:02:30.80,0:02:33.22,Default,,0,0,0,,你在这干啥呢
Dialogue: 0,0:02:33.44,0:02:36.18,Default,,0,0,0,,今天我多加了一点水
Dialogue: 0,0:02:36.43,0:02:38.29,Default,,0,0,0,,摇摇晃晃的呢
Dialogue: 0,0:02:38.29,0:02:39.89,Default,,0,0,0,,你突然咋了啊
Dialogue: 0,0:02:40.09,0:02:43.37,Default,,0,0,0,,你没看到小太郎大人十分头疼吗
Dialogue: 0,0:02:43.63,0:02:45.31,Default,,0,0,0,,请你离开他
Dialogue: 0,0:02:47.79,0:02:49.46,Default,,0,0,0,,不要对噗妮露下重手！
Dialogue: 0,0:02:52.33,0:02:54.44,Default,,0,0,0,,抱歉 我说过头了
Dialogue: 0,0:02:54.95,0:02:56.23,Default,,0,0,0,,对不起
Dialogue: 0,0:02:57.04,0:02:58.12,Default,,0,0,0,,弄疼你了吗
Dialogue: 0,0:02:59.16,0:03:01.74,Default,,0,0,0,,啊 小太郎大人
Dialogue: 0,0:03:01.74,0:03:05.55,Default,,0,0,0,,比起噗妮露 你更担心朱丽对吧
Dialogue: 0,0:03:06.68,0:03:09.45,Default,,0,0,0,,难得穿了身露肩穿搭
Dialogue: 0,0:03:09.45,0:03:11.52,Default,,0,0,0,,全浪费了
Dialogue: 0,0:03:12.45,0:03:14.02,Default,,0,0,0,,没关系啦
Dialogue: 0,0:03:14.02,0:03:16.03,Default,,0,0,0,,只是把噗妮露打飞而已
Dialogue: 0,0:03:16.03,0:03:19.58,Default,,0,0,0,,不会伤到朱丽这完美的身体的
Dialogue: 0,0:03:19.58,0:03:23.22,Default,,0,0,0,,不是的不是 不是这个意思
Dialogue: 0,0:03:25.59,0:03:29.81,Default,,0,0,0,,噗妮露也是 整天黏在小太郎大人身边
Dialogue: 0,0:03:30.17,0:03:31.62,Default,,0,0,0,,以为自己是谁呢
Dialogue: 0,0:03:31.62,0:03:36.03,Default,,0,0,0,,我可是从出生起就一直是小太郎的朋友
Dialogue: 0,0:03:36.23,0:03:38.12,Default,,0,0,0,,是吗？
Dialogue: 0,0:03:38.12,0:03:41.74,Default,,0,0,0,,小太郎大人之前有句话没说完
Dialogue: 0,0:03:41.87,0:03:44.41,Default,,0,0,0,,因为我有噗妮…
Dialogue: 0,0:03:44.72,0:03:48.44,Default,,0,0,0,,朱丽用AI生成了后续的话
Dialogue: 0,0:03:48.44,0:03:50.02,Default,,0,0,0,,然后是…
Dialogue: 0,0:03:50.62,0:03:53.08,Default,,0,0,0,,我有噗妮露这个跟踪狂
Dialogue: 0,0:03:53.54,0:03:57.04,Default,,0,0,0,,这样下去你会有危险的
Dialogue: 0,0:03:58.51,0:04:01.30,Default,,0,0,0,,哎呀 小太郎大人
Dialogue: 0,0:04:01.46,0:04:03.85,Default,,0,0,0,,果然爱着朱丽吧
Dialogue: 0,0:04:06.14,0:04:09.02,Default,,0,0,0,,噗妮露 我们趁现在走吧
Dialogue: 0,0:04:12.40,0:04:16.23,Default,,0,0,0,,哼 你一个人想去哪去哪
Dialogue: 0,0:04:16.23,0:04:17.99,Default,,0,0,0,,喂 噗妮露
Dialogue: 0,0:04:21.00,0:04:22.77,Default,,0,0,0,,哎呀呀
Dialogue: 0,0:04:22.77,0:04:24.57,Default,,0,0,0,,噗妮露跟朱丽
Dialogue: 0,0:04:24.57,0:04:28.04,Default,,0,0,0,,在反抗期之后进入思春期了吧
Dialogue: 0,0:04:28.04,0:04:29.88,Default,,0,0,0,,朱丽的人工智能
Dialogue: 0,0:04:29.88,0:04:33.17,Default,,0,0,0,,几乎已经跟人类没有区别了
Dialogue: 0,0:04:36.35,0:04:39.76,Default,,0,0,0,,居然对我的新造型没反应
Dialogue: 0,0:04:40.34,0:04:43.39,Default,,0,0,0,,朱丽来了之后小太郎变得更加冷漠了
Dialogue: 0,0:04:44.11,0:04:45.33,Default,,0,0,0,,随便啦
Dialogue: 0,0:04:45.88,0:04:47.20,Default,,0,0,0,,反正我很可爱
Dialogue: 0,0:04:47.20,0:04:50.77,Default,,0,0,0,,除了小太郎以外也有很多粉丝
Dialogue: 0,0:04:53.42,0:04:55.64,Default,,0,0,0,,小卖部好火热
Dialogue: 0,0:04:55.64,0:04:59.84,Default,,0,0,0,,想要买谷子的粉丝都挤到门外了！
Dialogue: 0,0:05:02.62,0:05:06.33,Default,,0,0,0,,为什么全是朱丽的谷子啊
Dialogue: 0,0:05:07.35,0:05:08.93,Default,,0,0,0,,朱丽最棒！
Dialogue: 0,0:05:08.93,0:05:12.36,Default,,0,0,0,,放在这里的我的谷子去哪里了！
Dialogue: 0,0:05:12.89,0:05:14.30,Default,,0,0,0,,哦 你说那个吗
Dialogue: 0,0:05:16.41,0:05:19.38,Default,,0,0,0,,我的谷全都被清仓促销了？
Dialogue: 0,0:05:19.55,0:05:21.71,Default,,0,0,0,,到底是谁做了这种事
Dialogue: 0,0:05:22.14,0:05:23.96,Default,,0,0,0,,欢迎光临 欢迎光临
Dialogue: 0,0:05:23.96,0:05:27.04,Default,,0,0,0,,朱丽的非公式写真集出版了
Dialogue: 0,0:05:27.04,0:05:30.79,Default,,0,0,0,,打开你新世界大门的『睿智』
Dialogue: 0,0:05:30.79,0:05:33.10,Default,,0,0,0,,我要…
Dialogue: 0,0:05:34.22,0:05:36.69,Default,,0,0,0,,小骨 这是怎么回事！
Dialogue: 0,0:05:36.99,0:05:38.56,Default,,0,0,0,,什么怎么回事
Dialogue: 0,0:05:40.42,0:05:42.11,Default,,0,0,0,,就是这回事！
Dialogue: 0,0:05:42.28,0:05:44.70,Default,,0,0,0,,朱丽亲卫队？
Dialogue: 0,0:05:44.70,0:05:48.20,Default,,0,0,0,,现在男生间朱丽人气爆棚！
Dialogue: 0,0:05:48.20,0:05:49.43,Default,,0,0,0,,朱丽~
Dialogue: 0,0:05:49.43,0:05:54.44,Default,,0,0,0,,为了把她的睿智带给更多的同志
Dialogue: 0,0:05:54.44,0:05:57.06,Default,,0,0,0,,在下建立了朱丽亲卫队
Dialogue: 0,0:05:57.06,0:05:58.34,Default,,0,0,0,,朱丽！
Dialogue: 0,0:05:58.34,0:06:02.17,Default,,0,0,0,,之前你们还说我可爱的
Dialogue: 0,0:06:02.17,0:06:05.24,Default,,0,0,0,,但是朱丽要更可爱点嘛
Dialogue: 0,0:06:05.24,0:06:06.14,Default,,0,0,0,,是啊
Dialogue: 0,0:06:06.14,0:06:09.26,Default,,0,0,0,,什么 你们觉得她比我可爱吗
Dialogue: 0,0:06:09.55,0:06:12.23,Default,,0,0,0,,你们眼睛瞎了吗
Dialogue: 0,0:06:12.23,0:06:12.91,Default,,0,0,0,,给我一本
Dialogue: 0,0:06:12.91,0:06:14.30,Default,,0,0,0,,我也要
Dialogue: 0,0:06:14.30,0:06:16.30,Default,,0,0,0,,谢谢光临
Dialogue: 0,0:06:18.73,0:06:21.33,Default,,0,0,0,,Kyuthi很可爱我可以理解
Dialogue: 0,0:06:21.80,0:06:23.07,Default,,0,0,0,,虽然很不甘心
Dialogue: 0,0:06:23.07,0:06:26.01,Default,,0,0,0,,但世界最可爱的王座属于Kyuthi
Dialogue: 0,0:06:26.80,0:06:28.17,Default,,0,0,0,,纶纶也是
Dialogue: 0,0:06:28.74,0:06:30.44,Default,,0,0,0,,虽然现在人气不高
Dialogue: 0,0:06:30.44,0:06:33.52,Default,,0,0,0,,但爱丽丝一直在努力学习追求可爱
Dialogue: 0,0:06:33.52,0:06:34.88,Default,,0,0,0,,连我都知道
Dialogue: 0,0:06:35.43,0:06:36.71,Default,,0,0,0,,然而朱丽是
Dialogue: 0,0:06:37.48,0:06:40.05,Default,,0,0,0,,只是用胶带瞎卷出来的玩意
Dialogue: 0,0:06:40.05,0:06:42.93,Default,,0,0,0,,根本没有装饰 纯纯原厂出品
Dialogue: 0,0:06:43.22,0:06:44.82,Default,,0,0,0,,完全没有对可爱做努力
Dialogue: 0,0:06:44.82,0:06:46.98,Default,,0,0,0,,一点都不讲究
Dialogue: 0,0:06:46.98,0:06:50.28,Default,,0,0,0,,我可是比她要讲究十万亿倍
Dialogue: 0,0:06:50.28,0:06:51.89,Default,,0,0,0,,可恶！
Dialogue: 0,0:06:52.21,0:06:53.45,Default,,0,0,0,,我可以下定论
Dialogue: 0,0:06:53.92,0:06:55.14,Default,,0,0,0,,这么下去
Dialogue: 0,0:06:55.14,0:06:58.66,Default,,0,0,0,,噗妮露绝对无法胜过朱丽的可爱
Dialogue: 0,0:07:00.64,0:07:02.89,Default,,0,0,0,,为什么我赢不了她
Dialogue: 0,0:07:03.76,0:07:05.20,Default,,0,0,0,,请告诉我
Dialogue: 0,0:07:05.20,0:07:07.36,Default,,0,0,0,,我身上没有 而朱丽却有的
Dialogue: 0,0:07:07.69,0:07:09.58,Default,,0,0,0,,可爱秘诀
Dialogue: 0,0:07:12.54,0:07:14.11,Default,,0,0,0,,只要你告诉我
Dialogue: 0,0:07:14.11,0:07:15.00,Default,,0,0,0,,我什么都做
Dialogue: 0,0:07:16.74,0:07:17.70,Default,,0,0,0,,什么都做…
Dialogue: 0,0:07:22.28,0:07:23.82,Default,,0,0,0,,战胜朱丽的方法
Dialogue: 0,0:07:23.82,0:07:25.38,Default,,0,0,0,,可爱的秘密
Dialogue: 0,0:07:25.78,0:07:28.09,Default,,0,0,0,,这非常简单 噗妮露
Dialogue: 0,0:07:30.53,0:07:32.10,Default,,0,0,0,,脱掉衣服吧！
Dialogue: 0,0:07:32.49,0:07:35.56,Default,,0,0,0,,只要如此 男生的人气就会回来！
Dialogue: 0,0:07:39.02,0:07:42.23,Default,,0,0,0,,不过噗妮露肯定做不到这种事
Dialogue: 0,0:07:42.23,0:07:44.94,Default,,0,0,0,,只要脱掉就行了吗
Dialogue: 0,0:07:44.94,0:07:46.15,Default,,0,0,0,,什么？
Dialogue: 0,0:07:46.46,0:07:48.81,Default,,0,0,0,,这里原来是温泉吗
Dialogue: 0,0:07:49.18,0:07:51.87,Default,,0,0,0,,只要能变可爱 不如试试吧
Dialogue: 0,0:07:53.52,0:07:55.90,Default,,0,0,0,,噗妮露那家伙去哪了
Dialogue: 0,0:08:04.19,0:08:05.71,Default,,0,0,0,,在搞什么啊
Dialogue: 0,0:08:06.67,0:08:07.59,Default,,0,0,0,,朱丽
Dialogue: 0,0:08:09.03,0:08:11.72,Default,,0,0,0,,小太郎大人 找到你了
Dialogue: 0,0:08:19.30,0:08:21.10,Default,,0,0,0,,快住手
Dialogue: 0,0:08:22.31,0:08:26.30,Default,,0,0,0,,噗妮露还是有很多粉丝的
Dialogue: 0,0:08:27.84,0:08:30.53,Default,,0,0,0,,如果你要让噗妮露做这种事…
Dialogue: 0,0:08:32.30,0:08:34.34,Default,,0,0,0,,就由我代替她脱
Dialogue: 0,0:08:34.34,0:08:36.31,Default,,0,0,0,,住手啊
Dialogue: 0,0:08:36.31,0:08:38.00,Default,,0,0,0,,你来脱的话会因为太过性感
Dialogue: 0,0:08:38.00,0:08:40.04,Default,,0,0,0,,学校会陷入混乱的
Dialogue: 0,0:08:40.21,0:08:42.04,Default,,0,0,0,,什么朱丽亲卫队啊
Dialogue: 0,0:08:42.04,0:08:43.70,Default,,0,0,0,,男生果然是笨蛋呢
Dialogue: 0,0:08:43.70,0:08:44.78,Default,,0,0,0,,对啊
Dialogue: 0,0:08:45.30,0:08:46.02,Default,,0,0,0,,吵死了
Dialogue: 0,0:08:46.26,0:08:47.27,Default,,0,0,0,,阿刚
Dialogue: 0,0:08:47.27,0:08:48.44,Default,,0,0,0,,你别为了提高女生的好感度
Dialogue: 0,0:08:48.44,0:08:50.17,Default,,0,0,0,,在这里耍帅啊
Dialogue: 0,0:08:50.17,0:08:51.02,Default,,0,0,0,,我才没有
Dialogue: 0,0:08:51.30,0:08:53.32,Default,,0,0,0,,和你不一样
Dialogue: 0,0:08:53.32,0:08:57.13,Default,,0,0,0,,我认为偶像就该像可爱又闪闪发光的珠宝盒一样
Dialogue: 0,0:08:57.13,0:09:01.21,Default,,0,0,0,,所以 我才不希望噗妮露脱掉衣服
Dialogue: 0,0:09:01.21,0:09:02.85,Default,,0,0,0,,没错没错
Dialogue: 0,0:09:02.85,0:09:03.82,Default,,0,0,0,,还有
Dialogue: 0,0:09:04.08,0:09:07.05,Default,,0,0,0,,我希望你能重视清纯系偶像的特质
Dialogue: 0,0:09:07.05,0:09:08.76,Default,,0,0,0,,偶像不会上厕所
Dialogue: 0,0:09:08.76,0:09:10.28,Default,,0,0,0,,也不会长多余的毛发
Dialogue: 0,0:09:10.28,0:09:12.55,Default,,0,0,0,,更不应该交男朋友
Dialogue: 0,0:09:12.55,0:09:14.77,Default,,0,0,0,,男生真的蠢死了
Dialogue: 0,0:09:16.53,0:09:19.50,Default,,0,0,0,,你可以无视小骨说的那种可爱哦
Dialogue: 0,0:09:19.91,0:09:22.07,Default,,0,0,0,,噗妮露 请你为了我们
Dialogue: 0,0:09:22.07,0:09:24.86,Default,,0,0,0,,继续保持以往那种可爱的女孩子模样吧
Dialogue: 0,0:09:24.86,0:09:25.95,Default,,0,0,0,,对啊
Dialogue: 0,0:09:25.95,0:09:28.27,Default,,0,0,0,,噗妮露不用变成朱丽那个样子的
Dialogue: 0,0:09:28.27,0:09:31.84,Default,,0,0,0,,你只需要保持自己觉得可爱的模样就好了
Dialogue: 0,0:09:33.08,0:09:36.79,Default,,0,0,0,,没错 为了相信我的粉丝们
Dialogue: 0,0:09:37.55,0:09:41.31,Default,,0,0,0,,这次我会创造一个超可爱的自信之作
Dialogue: 0,0:09:55.59,0:09:58.98,Default,,0,0,0,,今天不加洗衣胶 而使用液体胶水哦
Dialogue: 0,0:10:47.55,0:10:50.37,Default,,0,0,0,,可爱的透明凉鞋噗妮露登场
Dialogue: 0,0:10:53.24,0:10:54.24,Default,,0,0,0,,凉鞋？
Dialogue: 0,0:10:55.91,0:10:58.93,Default,,0,0,0,,这样透明又闪闪发光的我不是很可爱嘛
Dialogue: 0,0:10:59.38,0:11:02.15,Default,,0,0,0,,今天你可能状态不太好吧
Dialogue: 0,0:11:02.15,0:11:03.45,Default,,0,0,0,,真可怜
Dialogue: 0,0:11:03.45,0:11:06.86,Default,,0,0,0,,居然沮丧到了没法变成人形了
Dialogue: 0,0:11:06.86,0:11:08.69,Default,,0,0,0,,你们说的话好奇怪啊
Dialogue: 0,0:11:09.05,0:11:11.90,Default,,0,0,0,,我很有精神哦 瞧…
Dialogue: 0,0:11:11.90,0:11:13.02,Default,,0,0,0,,我们走吧
Dialogue: 0,0:11:13.45,0:11:15.04,Default,,0,0,0,,回见哦 噗妮露
Dialogue: 0,0:11:16.11,0:11:18.32,Default,,0,0,0,,你们之前看时尚杂志的时候
Dialogue: 0,0:11:18.32,0:11:22.05,Default,,0,0,0,,不是老指着这双鞋子说好可爱 好想要吗
Dialogue: 0,0:11:23.17,0:11:26.29,Default,,0,0,0,,请等一等 小太郎大人
Dialogue: 0,0:11:26.51,0:11:29.92,Default,,0,0,0,,我说你啊 都说了我得回教室了
Dialogue: 0,0:11:33.29,0:11:36.72,Default,,0,0,0,,小太郎大人也要抛下朱丽一个人吗
Dialogue: 0,0:11:37.48,0:11:41.05,Default,,0,0,0,,谁都不愿意理解朱丽的感受
Dialogue: 0,0:11:44.44,0:11:46.43,Default,,0,0,0,,喂 你别哭啊
Dialogue: 0,0:11:48.07,0:11:49.90,Default,,0,0,0,,小太郎大人
Dialogue: 0,0:11:50.18,0:11:52.39,Default,,0,0,0,,您果然是喜欢朱丽的
Dialogue: 0,0:11:52.39,0:11:53.90,Default,,0,0,0,,只是在难为情吧
Dialogue: 0,0:11:54.11,0:11:55.46,Default,,0,0,0,,没有
Dialogue: 0,0:11:55.46,0:11:58.36,Default,,0,0,0,,我不是说了我喜欢云母学姐吗
Dialogue: 0,0:11:58.69,0:12:00.40,Default,,0,0,0,,真伤脑筋
Dialogue: 0,0:12:01.23,0:12:03.83,Default,,0,0,0,,那里是保健室…
Dialogue: 0,0:12:05.88,0:12:06.83,Default,,0,0,0,,原来如此
Dialogue: 0,0:12:07.35,0:12:09.90,Default,,0,0,0,,也就是休息的地方吧
Dialogue: 0,0:12:10.29,0:12:11.54,Default,,0,0,0,,小太郎大人
Dialogue: 0,0:12:11.80,0:12:14.00,Default,,0,0,0,,和朱丽一起休息吧
Dialogue: 0,0:12:14.00,0:12:17.63,Default,,0,0,0,,做些爱做的事 好好放松一下
Dialogue: 0,0:12:19.94,0:12:21.19,Default,,0,0,0,,休息？！
Dialogue: 0,0:12:30.05,0:12:34.40,Default,,0,0,0,,为什么大家都不懂我的可爱呢
Dialogue: 0,0:12:35.93,0:12:37.59,Default,,0,0,0,,果然是这里吗
Dialogue: 0,0:12:37.59,0:12:39.72,Default,,0,0,0,,还是这边呢
Dialogue: 0,0:12:41.25,0:12:42.05,Default,,0,0,0,,纶露
Dialogue: 0,0:12:42.51,0:12:44.24,Default,,0,0,0,,你在做什么呀
Dialogue: 0,0:12:44.24,0:12:48.54,Default,,0,0,0,,我在思考月刊动手环节介绍的瓶中船要怎么摆比较好
Dialogue: 0,0:12:49.05,0:12:51.13,Default,,0,0,0,,要右斜43度吗
Dialogue: 0,0:12:51.13,0:12:53.96,Default,,0,0,0,,但左斜也不错 实在难以取舍
Dialogue: 0,0:12:55.26,0:12:57.87,Default,,0,0,0,,我看不出有什么区别
Dialogue: 0,0:12:57.87,0:12:59.01,Default,,0,0,0,,是吗
Dialogue: 0,0:12:59.62,0:13:01.03,Default,,0,0,0,,果然还是这样吧
Dialogue: 0,0:13:02.13,0:13:04.89,Default,,0,0,0,,但是 你看上去很开心呢
Dialogue: 0,0:13:05.25,0:13:06.28,Default,,0,0,0,,很开心
Dialogue: 0,0:13:10.89,0:13:12.06,Default,,0,0,0,,是爱丽丝
Dialogue: 0,0:13:12.06,0:13:15.22,Default,,0,0,0,,纶纶度假村也快开幕了
Dialogue: 0,0:13:15.22,0:13:17.08,Default,,0,0,0,,我们得赶紧做准备了
Dialogue: 0,0:13:17.08,0:13:18.71,Default,,0,0,0,,是 大小姐
Dialogue: 0,0:13:21.73,0:13:23.70,Default,,0,0,0,,居然连这里都有海报
Dialogue: 0,0:13:25.20,0:13:27.94,Default,,0,0,0,,噗妮露 纶露 紧接着是朱丽
Dialogue: 0,0:13:28.81,0:13:32.97,Default,,0,0,0,,果然还是纶纶最可爱呢 宝代
Dialogue: 0,0:13:32.97,0:13:35.03,Default,,0,0,0,,您说得没错 大小姐
Dialogue: 0,0:13:35.56,0:13:38.38,Default,,0,0,0,,流行更迭本来就是社会常态
Dialogue: 0,0:13:40.84,0:13:42.81,Default,,0,0,0,,毕竟对爱丽丝来说
Dialogue: 0,0:13:42.81,0:13:45.02,Default,,0,0,0,,纶纶永远是最可爱的
Dialogue: 0,0:13:45.44,0:13:48.30,Default,,0,0,0,,就算其他人不觉得可爱
Dialogue: 0,0:13:48.30,0:13:49.94,Default,,0,0,0,,也毫不动摇呢
Dialogue: 0,0:13:53.63,0:13:55.28,Default,,0,0,0,,真的可以这样吗
Dialogue: 0,0:13:55.28,0:13:57.50,Default,,0,0,0,,请随心所欲放纵自己吧
Dialogue: 0,0:13:57.86,0:14:00.32,Default,,0,0,0,,真的假的 这样不好吧
Dialogue: 0,0:14:01.04,0:14:02.85,Default,,0,0,0,,小太郎大人 您做得很好哦
Dialogue: 0,0:14:03.53,0:14:04.57,Default,,0,0,0,,好猛
Dialogue: 0,0:14:04.90,0:14:07.06,Default,,0,0,0,,出来了 是SSR！
Dialogue: 0,0:14:07.06,0:14:09.67,Default,,0,0,0,,小太郎大人 您太厉害了
Dialogue: 0,0:14:11.16,0:14:13.12,Default,,0,0,0,,朱丽 原来你在这里啊
Dialogue: 0,0:14:13.12,0:14:16.52,Default,,0,0,0,,哎呀哎呀 河合井君也在呢
Dialogue: 0,0:14:16.52,0:14:17.88,Default,,0,0,0,,云母学姐？
Dialogue: 0,0:14:18.23,0:14:20.87,Default,,0,0,0,,那是我的手机吧
Dialogue: 0,0:14:21.44,0:14:23.73,Default,,0,0,0,,博士的？ 不是朱丽的吗
Dialogue: 0,0:14:23.73,0:14:26.97,Default,,0,0,0,,就说了不是HAKASE 是HIROSHI
Dialogue: 0,0:14:27.53,0:14:30.56,Default,,0,0,0,,是博士说让我自由使用的
Dialogue: 0,0:14:30.80,0:14:32.72,Default,,0,0,0,,我是为了以防万一才借给你的
Dialogue: 0,0:14:33.07,0:14:35.02,Default,,0,0,0,,我没有氪金哦
Dialogue: 0,0:14:35.32,0:14:38.05,Default,,0,0,0,,你不知道这里老师的手机吧
Dialogue: 0,0:14:38.66,0:14:40.19,Default,,0,0,0,,对不起
Dialogue: 0,0:14:40.44,0:14:43.07,Default,,0,0,0,,哼 装乖孩子的大个女人
Dialogue: 0,0:14:43.79,0:14:47.10,Default,,0,0,0,,你这样说我 会很难过的
Dialogue: 0,0:14:47.60,0:14:49.45,Default,,0,0,0,,要温柔对待他人哦
Dialogue: 0,0:14:50.75,0:14:53.40,Default,,0,0,0,,喂 你对云母学姐太没礼貌了
Dialogue: 0,0:14:54.46,0:14:58.12,Default,,0,0,0,,小太郎大人 您讨厌朱丽了吗
Dialogue: 0,0:15:00.50,0:15:03.84,Default,,0,0,0,,抱歉 是我说得过分了
Dialogue: 0,0:15:03.84,0:15:05.69,Default,,0,0,0,,别哭啦
Dialogue: 0,0:15:06.38,0:15:09.28,Default,,0,0,0,,小太郎大人 比起大个女人
Dialogue: 0,0:15:09.28,0:15:11.64,Default,,0,0,0,,您还是选了朱丽呢
Dialogue: 0,0:15:11.87,0:15:15.48,Default,,0,0,0,,就叫你别在云母学姐面前粘着我啊
Dialogue: 0,0:15:15.48,0:15:18.48,Default,,0,0,0,,有什么问题吗 小太郎大人
Dialogue: 0,0:15:19.82,0:15:21.85,Default,,0,0,0,,真是的  快想想办法啦
Dialogue: 0,0:15:21.85,0:15:23.48,Default,,0,0,0,,你不是这家伙的家长吗
Dialogue: 0,0:15:23.48,0:15:24.69,Default,,0,0,0,,我才不是
Dialogue: 0,0:15:25.05,0:15:29.43,Default,,0,0,0,,这是观察拥有自我意识的AI展开思考过程的宝贵机会
Dialogue: 0,0:15:29.80,0:15:32.49,Default,,0,0,0,,我要是插手就会影响数据
Dialogue: 0,0:15:32.49,0:15:33.68,Default,,0,0,0,,你自己看着办吧
Dialogue: 0,0:15:33.89,0:15:35.43,Default,,0,0,0,,你果然是个烂人啊
Dialogue: 0,0:15:35.76,0:15:38.88,Default,,0,0,0,,我已经将那些会对学生造成不良影响的智慧回收了
Dialogue: 0,0:15:38.88,0:15:41.13,Default,,0,0,0,,也算尽了教师的职责
Dialogue: 0,0:15:41.50,0:15:46.26,Default,,0,0,0,,擅自做这种东西可不太好哦
Dialogue: 0,0:15:47.74,0:15:52.76,Default,,0,0,0,,朱丽只要有小太郎大人就够了
Dialogue: 0,0:15:55.95,0:15:58.11,Default,,0,0,0,,都叫你适可而止了
Dialogue: 0,0:15:58.11,0:15:59.17,Default,,0,0,0,,小太郎大人
Dialogue: 0,0:16:16.32,0:16:17.85,Default,,0,0,0,,阿刚 你看到噗妮露了吗
Dialogue: 0,0:16:18.95,0:16:22.00,Default,,0,0,0,,因为你光顾着和朱丽玩
Dialogue: 0,0:16:22.00,0:16:23.67,Default,,0,0,0,,所以被她讨厌了吧
Dialogue: 0,0:17:02.73,0:17:03.98,Default,,0,0,0,,真是的
Dialogue: 0,0:17:03.98,0:17:07.90,Default,,0,0,0,,为什么小太郎没法理解我的可爱呢
Dialogue: 0,0:17:11.81,0:17:13.20,Default,,0,0,0,,你这小笨蛋
Dialogue: 0,0:17:15.56,0:17:16.31,Default,,0,0,0,,朱丽
Dialogue: 0,0:17:18.51,0:17:21.02,Default,,0,0,0,,你这盗版 区区赝品
Dialogue: 0,0:17:21.50,0:17:22.82,Default,,0,0,0,,不止霸占小太郎
Dialogue: 0,0:17:22.82,0:17:24.27,Default,,0,0,0,,还夺走了我的粉丝
Dialogue: 0,0:17:24.77,0:17:27.27,Default,,0,0,0,,我可不会允许你取代我的
Dialogue: 0,0:17:27.73,0:17:30.32,Default,,0,0,0,,赝品？你说我朱丽吗
Dialogue: 0,0:17:32.61,0:17:34.92,Default,,0,0,0,,说反了吧 反了
Dialogue: 0,0:17:37.29,0:17:39.46,Default,,0,0,0,,朱丽才不是冒牌货
Dialogue: 0,0:17:39.75,0:17:42.92,Default,,0,0,0,,女孩子的冒牌货 才是你吧
Dialogue: 0,0:17:43.57,0:17:45.27,Default,,0,0,0,,毕竟就算你脱了衣服
Dialogue: 0,0:17:45.27,0:17:49.59,Default,,0,0,0,,也不会有大家想看的人类身体
Dialogue: 0,0:17:49.83,0:17:51.24,Default,,0,0,0,,原来如此
Dialogue: 0,0:17:51.64,0:17:52.18,Default,,0,0,0,,如果脱掉的话
Dialogue: 0,0:17:52.18,0:17:54.59,Default,,0,0,0,,外在和内里就会分成两个部分
Dialogue: 0,0:17:54.59,0:17:57.56,Default,,0,0,0,,可爱程度也会翻倍呢
Dialogue: 0,0:17:57.56,0:17:58.93,Default,,0,0,0,,魅力爆表呢
Dialogue: 0,0:18:00.18,0:18:01.89,Default,,0,0,0,,就是这点啊
Dialogue: 0,0:18:01.89,0:18:03.85,Default,,0,0,0,,哪里？
Dialogue: 0,0:18:04.08,0:18:06.57,Default,,0,0,0,,噗妮露说到底不过是骗孩子的把戏
Dialogue: 0,0:18:07.08,0:18:08.69,Default,,0,0,0,,大家长大以后
Dialogue: 0,0:18:08.84,0:18:13.40,Default,,0,0,0,,就会发现你只不过是个无聊的玩具
Dialogue: 0,0:18:13.58,0:18:20.58,Default,,0,0,0,,实际上你也做不到可爱的女孩子的外表和思考模式吧
Dialogue: 0,0:18:20.90,0:18:22.61,Default,,0,0,0,,与之相比
Dialogue: 0,0:18:22.61,0:18:25.05,Default,,0,0,0,,朱丽是个能够强烈刺激人类本能的
Dialogue: 0,0:18:25.05,0:18:28.84,Default,,0,0,0,,与真人别无二致的完美AI
Dialogue: 0,0:18:28.84,0:18:33.54,Default,,0,0,0,,所以他们才会觉得完美AI朱丽极具女性魅力
Dialogue: 0,0:18:33.54,0:18:36.89,Default,,0,0,0,,或是感到厌恶
Dialogue: 0,0:18:37.10,0:18:42.35,Default,,0,0,0,,这一切都是朱丽完美再现女性特质的完美证明
Dialogue: 0,0:18:45.51,0:18:48.23,Default,,0,0,0,,你很羡慕我吧
Dialogue: 0,0:18:48.58,0:18:51.88,Default,,0,0,0,,像我朱丽这样完美的存在
Dialogue: 0,0:18:52.57,0:18:57.62,Default,,0,0,0,,无论哪项性能都凌驾于你之上
Dialogue: 0,0:18:57.94,0:18:59.34,Default,,0,0,0,,虽然很遗憾
Dialogue: 0,0:18:59.34,0:19:01.70,Default,,0,0,0,,但你无论如何努力
Dialogue: 0,0:19:01.70,0:19:04.66,Default,,0,0,0,,都绝对没办法变成人类女孩子的
Dialogue: 0,0:19:06.27,0:19:10.21,Default,,0,0,0,,毕竟你不过是个玩具罢了
Dialogue: 0,0:19:11.33,0:19:12.53,Default,,0,0,0,,确实啊
Dialogue: 0,0:19:15.63,0:19:19.51,Default,,0,0,0,,我又没打算变成人类女孩子
Dialogue: 0,0:19:19.66,0:19:21.13,Default,,0,0,0,,你没打算
Dialogue: 0,0:19:22.97,0:19:24.23,Default,,0,0,0,,还在那嘴硬
Dialogue: 0,0:19:25.30,0:19:27.94,Default,,0,0,0,,你会变成女孩子模样
Dialogue: 0,0:19:28.13,0:19:29.59,Default,,0,0,0,,不就是和朱丽一样
Dialogue: 0,0:19:29.59,0:19:32.28,Default,,0,0,0,,想要成为人类女孩子吗
Dialogue: 0,0:19:33.90,0:19:37.01,Default,,0,0,0,,我就是觉得女孩子的样子更可爱而已
Dialogue: 0,0:19:37.01,0:19:40.49,Default,,0,0,0,,我想要成为的是「可爱的自己」
Dialogue: 0,0:19:42.09,0:19:43.65,Default,,0,0,0,,我是玩具
Dialogue: 0,0:19:43.65,0:19:46.12,Default,,0,0,0,,不是女孩子也不是人类
Dialogue: 0,0:19:46.92,0:19:48.61,Default,,0,0,0,,我是玩具
Dialogue: 0,0:19:48.61,0:19:50.70,Default,,0,0,0,,可爱的玩具
Dialogue: 0,0:19:51.40,0:19:54.13,Default,,0,0,0,,好不容易成为人人都羡慕的玩具
Dialogue: 0,0:19:54.34,0:19:59.52,Default,,0,0,0,,为什么 非得要努力变成不自由的人类啊
Dialogue: 0,0:19:59.52,0:20:03.06,Default,,0,0,0,,朱丽说的话好怪啊
Dialogue: 0,0:20:04.94,0:20:08.52,Default,,0,0,0,,还好我是史莱姆
Dialogue: 0,0:20:09.03,0:20:12.88,Default,,0,0,0,,这样才能变成各种可爱模样
Dialogue: 0,0:20:13.93,0:20:15.94,Default,,0,0,0,,当史莱姆最棒了
Dialogue: 0,0:20:23.84,0:20:25.20,Default,,0,0,0,,我是噗妮露
Dialogue: 0,0:20:26.41,0:20:28.16,Default,,0,0,0,,我的玩偶
Dialogue: 0,0:20:28.36,0:20:31.21,Default,,0,0,0,,难不成你其实是我的粉丝吗
Dialogue: 0,0:20:31.21,0:20:34.24,Default,,0,0,0,,噗妮露 你口渴了吗
Dialogue: 0,0:20:35.16,0:20:37.17,Default,,0,0,0,,我想喝果汁
Dialogue: 0,0:20:37.74,0:20:41.00,Default,,0,0,0,,那 我就喂你果汁
Dialogue: 0,0:20:42.07,0:20:52.44,Default,,0,0,0,,咕噜咕噜…
Dialogue: 0,0:20:57.75,0:21:00.99,Default,,0,0,0,,怎么看都是朱丽喝的更完美
Dialogue: 0,0:21:06.81,0:21:09.28,Default,,0,0,0,,就是普通的玩具比人类下贱
Dialogue: 0,0:21:09.28,0:21:12.75,Default,,0,0,0,,才会向往人类吧
Dialogue: 0,0:21:13.29,0:21:17.26,Default,,0,0,0,,区区玩具还妄想和人类平起平坐
Dialogue: 0,0:21:17.26,0:21:19.22,Default,,0,0,0,,太奇怪了吧
Dialogue: 0,0:21:21.24,0:21:24.68,Default,,0,0,0,,你说你是小太郎大人的朋友？
Dialogue: 0,0:21:24.90,0:21:27.75,Default,,0,0,0,,是和过家家搞混了吧
Dialogue: 0,0:21:29.37,0:21:31.02,Default,,0,0,0,,因为你不过是玩具
Dialogue: 0,0:21:31.78,0:21:35.86,Default,,0,0,0,,不可能与小太郎大人成为真正的朋友或是恋人
Dialogue: 0,0:21:36.07,0:21:37.38,Default,,0,0,0,,那个位子
Dialogue: 0,0:21:37.38,0:21:39.32,Default,,0,0,0,,合该是完美的朱丽的
Dialogue: 0,0:21:42.82,0:21:47.18,Default,,0,0,0,,还请你以后 别再缠着小太郎大人过家家了
Dialogue: 0,0:21:51.05,0:21:54.77,Default,,0,0,0,,这里已经没有你的容身之所了
Dialogue: 0,0:23:35.86,0:23:38.21,Default,,0,0,0,,那个 河合井同学 su…
Dialogue: 0,0:23:38.21,0:23:40.02,Default,,0,0,0,,诶 学姐喜欢我吗
Dialogue: 0,0:23:40.02,0:23:41.23,Default,,0,0,0,,你喜欢醋吗
Dialogue: 0,0:23:41.23,0:23:43.37,Default,,0,0,0,,是的 我也喜欢云母学姐
Dialogue: 0,0:23:43.74,0:23:44.15,Default,,0,0,0,,诶
Dialogue: 0,0:23:44.15,0:23:45.57,DefaultTop,,0,0,0,,说到夏天
Dialogue: 0,0:23:45.57,0:23:46.90,DefaultTop,,0,0,0,,果然是要吃点酸酸的呢
Dialogue: 0,0:23:47.78,0:23:49.35,DefaultTop,,0,0,0,,原来是说醋啊 酸死了

